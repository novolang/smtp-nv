// ```
pub fn reader_with(max_line: Int, max_lines: Int) -> SmtpReader []
    todo("smtp-nv.smtpwire.reader_with")

// Whether a buffer holds a whole reply yet, without consuming
// anything.
//
// For a caller sizing its next read.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     match smtpwire.scan([])
//         SmtpNeedLine    => println("more")
//         SmtpReplyAt(at) => println("${at}")
// ```
pub fn scan(buf: [u8]) -> SmtpScan []
    todo("smtp-nv.smtpwire.scan")

// Feed bytes, and take the first reply they completed.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     match smtpwire.feed(smtpwire.reader(), [])
//         Ok(_)  => println("fed")
//         Err(_) => println("refused")
// ```
pub fn feed(r: SmtpReader, data: [u8]) -> Result<SmtpStep, SmtpWireError> []
    todo("smtp-nv.smtpwire.feed")

// Take the next reply out of what has already been fed.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     match smtpwire.take(smtpwire.reader())
//         Ok(_)  => println("taken")
//         Err(_) => println("refused")
// ```
pub fn take(r: SmtpReader) -> Result<SmtpStep, SmtpWireError> []
    todo("smtp-nv.smtpwire.take")

// How many fed bytes have not yet made a reply.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.pending_len(smtpwire.reader())}")
// ```
pub fn pending_len(r: SmtpReader) -> Int []
    todo("smtp-nv.smtpwire.pending_len")

// One whole reply parsed out of a complete buffer.
//
// The convenience for a caller that already has the bytes.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     match smtpwire.parse_reply([])
//         Ok(r)  => println("${r.code}")
//         Err(_) => println("not a reply")
// ```
pub fn parse_reply(buf: [u8]) -> Result<SmtpReply, SmtpWireError> []
    todo("smtp-nv.smtpwire.parse_reply")

// The class of a reply code — the only part a client may branch on.
//
// A client that retried a 550 sends the same rejection over and over;
// one that gave up on a 451 loses mail that would have gone through in
// a minute.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     match smtpwire.class_of(451)
//         SmtpTransient => println("try again")
//         _             => println("something else")
// ```
pub fn class_of(code: Int) -> SmtpReplyClass []
    todo("smtp-nv.smtpwire.class_of")

// True for a 2yz.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.is_positive(250)}")
// ```
pub fn is_positive(code: Int) -> Bool []
    todo("smtp-nv.smtpwire.is_positive")

// True when trying the same thing later could work: a 4yz, and
// nothing else.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.is_temporary(451)}")
// ```
pub fn is_temporary(code: Int) -> Bool []
    todo("smtp-nv.smtpwire.is_temporary")

// The bytes of a command, CRLF included.
//
// ```novo
// use smtpwire
// use std.list
//
// fn main() [io]
//     match smtpwire.encode(SmtpQuit)
//         Ok(b)  => println("${list.len(b)}")
//         Err(_) => println("refused")
// ```
pub fn encode(c: SmtpCommand) -> Result<[u8], SmtpWireError> []
    todo("smtp-nv.smtpwire.encode")

// The capability list an EHLO reply describes.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     let r = SmtpReply { code: 250, enhanced: "", lines: [] }
//     println("${smtpwire.capabilities_of(r).starttls}")
// ```
pub fn capabilities_of(r: SmtpReply) -> SmtpCapabilities []
    todo("smtp-nv.smtpwire.capabilities_of")

// Capabilities with nothing announced.
//
// What a session holds before EHLO, and — this is the load-bearing
// use — what it is reset to the moment STARTTLS succeeds.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.no_capabilities().pipelining}")
// ```
pub fn no_capabilities() -> SmtpCapabilities []
    todo("smtp-nv.smtpwire.no_capabilities")

// A message body with its dots stuffed and its terminator appended,
// ready to follow a DATA.
//
// Both halves in one function, because a caller that stuffed and
// forgot the terminator hangs and a caller that terminated without
// stuffing truncates — and the second is silent.
//
// ```novo
// use smtpwire
// use std.list
//
// fn main() [io]
//     match smtpwire.data_body([])
//         Ok(b)  => println("${list.len(b)}")
//         Err(_) => println("refused")
// ```
pub fn data_body(message: [u8]) -> Result<[u8], SmtpWireError> []
    todo("smtp-nv.smtpwire.data_body")

// The reverse of `data_body`: a transmitted body back to the message
// it was made from.
//
// Published because it is what makes `data_body` testable as a round
// trip, and because a proxy needs it.
//
// ```novo
// use smtpwire
// use std.list
//
// fn main() [io]
//     match smtpwire.undo_dot_stuffing([])
//         Ok(b)  => println("${list.len(b)}")
//         Err(_) => println("refused")
// ```
pub fn undo_dot_stuffing(transmitted: [u8]) -> Result<[u8], SmtpWireError> []
    todo("smtp-nv.smtpwire.undo_dot_stuffing")

// How many bytes a message becomes on the wire after stuffing and
// termination.
//
// What a `MAIL FROM ... SIZE=` parameter has to carry, and what a
// server's announced `SIZE` limit is compared against.  A client that
// declared the unstuffed length can be refused for a message that
// would have fitted.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.transmitted_size([])}")
// ```
pub fn transmitted_size(message: [u8]) -> Int []
    todo("smtp-nv.smtpwire.transmitted_size")

// True when a set of commands may be sent back to back without
// waiting for each reply.
//
// RFC 2920's rule and not a preference: `EHLO`, `DATA`, `STARTTLS`,
// `QUIT` and every AUTH exchange are barriers, and everything else —
// `MAIL FROM`, every `RCPT TO`, `RSET`, `NOOP` — may be grouped.  A
// client that pipelined a DATA has sent the body before the server
// agreed to receive it.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.may_pipeline([SmtpRset, SmtpNoop])}")
// ```
pub fn may_pipeline(group: [SmtpCommand]) -> Bool []
    todo("smtp-nv.smtpwire.may_pipeline")

// Why a reply or a command could not be read or written.
pub enum SmtpWireError
    // A reply line longer than the limit.
    SmtpLineTooLong(at: Int, len: Int)
    // More continuation lines than the limit, which is a server — or
    // something pretending to be one — sending an unbounded reply.
    SmtpTooManyReplyLines(count: Int)
    // A line that does not begin with three digits and a separator.
    SmtpMalformedReply(at: Int)
    // A reply code outside 200..599.
    SmtpReplyCodeOutOfRange(code: Int)
    // A command argument with a CR or LF in it.  **This is the
    // injection defence**: an address or a domain carrying a newline
    // would end the command and begin another one the caller never
    // wrote, which is how a header-injection bug in a web form becomes
    // an open relay.
    SmtpControlCharacterInArgument(what: Str)
    // A command line longer than 512 bytes.
    SmtpCommandTooLong(len: Int)

// The one-line reading, for a log or a person.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     let e: SmtpWireError = SmtpTooManyReplyLines(500)
//     println(e.message())
// ```
impl Error for SmtpWireError
    fn message(self) -> Str
        todo("smtp-nv.smtpwire.message")
