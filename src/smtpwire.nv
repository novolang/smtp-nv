// smtpwire.nv — the command and reply codec.  Sans-IO, and every row
// here is `[]`.
//
// Every body here is a `todo()`; the signatures are the design.
//
// THIS MODULE IS `core`-SHAPED INSIDE A `host` PACKAGE, and that is a
// decision rather than an accident.  There is no `smtp-codec-nv` on
// the grid: SMTP's wire format is a line, a three-digit number and a
// space — perhaps two hundred lines of arithmetic all told — and the
// whole of the interesting behaviour is in the conversation rather than
// in the bytes.  A separate package would have been a package whose
// README said "this parses `250 OK`", which is not a package anybody
// browses to.  The README argues what would change that.
//
// SO THE RULE IS KEPT WITHOUT THE PACKAGE: nothing in this module
// performs anything, everything is a function from bytes or values to
// values, and a test asserts an entire session transcript with no
// socket.  If SMTP ever grows a second consumer that wants the codec
// and not the session — a server, a milter, a proxy — this module
// lifts out unchanged.
//
// THE THREE THINGS A WRONG SMTP CODEC GETS WRONG QUIETLY, each of
// which is an assertion in `tests/smtpwire_tests.nv`:
//
//   A MULTILINE REPLY IS ONE REPLY.  `250-SIZE` continues and
//   `250 SIZE` ends, and the difference is one character in column
//   four.  A client that treated each line as a reply reads the
//   capability list as five separate answers and then answers the
//   wrong command.
//
//   A LINE BEGINNING WITH A DOT IS DOUBLED, and the terminator is
//   `\r\n.\r\n`.  A message whose body has a line that is just `.`
//   ends the DATA early without any error at all: the server accepts
//   half a message and the rest is interpreted as commands.
//
//   THE REPLY CODE'S FIRST DIGIT IS THE ONLY PART A CLIENT MAY BRANCH
//   ON.  4 is temporary and 5 is permanent, and a client that retried
//   a 550 or gave up on a 451 is a client that either loses mail or
//   sends it twice.

// One SMTP command, as a value.
pub enum SmtpCommand
    // `EHLO <domain>`.  Never `HELO` first: a submission client that
    // opened with HELO gets no capability list, so no STARTTLS, no
    // AUTH and no SIZE.
    SmtpEhlo(domain: Str)
    // `HELO <domain>`, for a server that refused EHLO.
    SmtpHelo(domain: Str)
    SmtpStartTls
    // `AUTH <mechanism>` with an optional initial response, which
    // saves a round trip where the server advertised it.
    SmtpAuth(mechanism: Str, initial: ?Str)
    // A bare base64 line in the middle of an AUTH exchange.
    SmtpAuthContinue(response: Str)
    // `MAIL FROM:<addr>` with ESMTP parameters — `SIZE=`, `BODY=`.
    SmtpMailFrom(reverse_path: Str, params: [Str])
    // `RCPT TO:<addr>`.  One per recipient: the envelope is not a
    // header, and a message to twelve people is twelve of these.
    SmtpRcptTo(forward_path: Str, params: [Str])
    SmtpData
    // `.` on its own line, ending DATA.
    SmtpEndOfData
    // `RSET`, which abandons the current transaction and keeps the
    // session — including the authentication, which is why it is the
    // right answer to a rejected recipient.
    SmtpRset
    SmtpNoop
    SmtpQuit

// A reply's leading digit, which is the only part a client may branch
// on.
pub enum SmtpReplyClass
    // 2yz — it worked.
    SmtpPositive
    // 3yz — send more: the server is waiting for the DATA body or the
    // next AUTH line.
    SmtpIntermediate
    // 4yz — TEMPORARY.  Try again later; the message is not lost.
    SmtpTransient
    // 5yz — PERMANENT.  Trying again gets the same answer, and a
    // client that retried is a client sending the same rejection over
    // and over.
    SmtpPermanent

// One reply, multiline or not.
//
// `lines` holds the text of every line with the code and the separator
// removed, so a five-line capability list is five strings and the
// caller never parses column four.
pub struct SmtpReply
    code: Int
    // RFC 3463's enhanced status code — `5.7.1` — when the server sent
    // one, and `""` when it did not.  Separate from `code` because it
    // is the part that says WHY where the three digits say only what
    // class, and a bounce message that quoted only the three digits is
    // a bounce nobody can act on.
    enhanced: Str
    lines: [Str]

// What a reader has, when it does not yet have a whole reply.
pub enum SmtpScan
    // More bytes are needed.
    SmtpNeedLine
    // A whole reply ends at this offset.
    SmtpReplyAt(end: Int)

// The reader between "some bytes turned up" and "here is a reply".
//
// Opaque: the fields are here because a struct needs them, and a
// caller that reaches into one has coupled itself to a buffering
// decision this module intends to change.
pub struct SmtpReader
    pending: [u8]
    offset: Int
    max_line: Int
    max_lines: Int

// A reader and the one reply that came out of it, if one did.
pub struct SmtpStep
    reader: SmtpReader
    reply: ?SmtpReply

// What an EHLO's capability list said this server can do.
pub struct SmtpCapabilities
    // The greeting line, before the list.
    greeting: Str
    starttls: Bool
    pipelining: Bool
    // The SMTPUTF8 extension: an address with a non-ASCII character in
    // it may be used literally rather than punycoded.
    smtputf8: Bool
    // `8BITMIME`: a body may carry bytes above 127 without being
    // encoded.
    eight_bit_mime: Bool
    // `SIZE` in bytes; zero when the server announced no limit.
    max_size: Int
    // The AUTH mechanisms the server offered, in the order it listed
    // them.
    auth_mechanisms: [Str]
    // Everything else, as it arrived, for a caller that knows an
    // extension this package does not.
    other: [Str]

// The longest line SMTP allows including CRLF, 1000 bytes.
//
// RFC 5321 § 4.5.3.1.6.  A message with a longer line has to be
// encoded — quoted-printable or base64 — and `smtpmsg` is what chooses.
pub const SMTP_LINE_MAX = 1000

// The longest command line, 512 bytes.
pub const SMTP_COMMAND_MAX = 512

// The submission port, 587 (RFC 6409).
//
// NOT 25.  Port 25 is server-to-server relay, is blocked outbound by
// most networks, and does not require authentication; submission is
// 587, requires it, and is what a program sending its own mail uses.
pub const SMTP_SUBMISSION_PORT = 587

// The implicit-TLS submission port, 465 (RFC 8314).
//
// TLS from the first byte, with no STARTTLS at all — which is what
// RFC 8314 now prefers, because a STARTTLS that can be stripped is a
// STARTTLS an attacker removes.
pub const SMTP_SUBMISSIONS_PORT = 465

// The plain SMTP port, 25.
pub const SMTP_PORT = 25

// A reader with the default limits.
//
// ```novo
// use smtpwire
//
// fn main() [io]
//     println("${smtpwire.reader().max_line}")
// ```
pub fn reader() -> SmtpReader []
    todo("smtp-nv.smtpwire.reader")

